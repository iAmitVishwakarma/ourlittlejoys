# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api

# Backend Services (Node.js / Express / Django)
VITE_BACKEND_URL=http://localhost:5000

# Payment Gateway (Razorpay / Cashfree)
# NOTE: Only the PUBLIC key_id is safe for the browser.
# The KEY_SECRET must ONLY exist on the backend server (.env), never prefixed with VITE_.
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
# RAZORPAY_KEY_SECRET belongs in the BACKEND .env only — do NOT add a VITE_ prefix.

# SMS & OTP Service (Twilio / Fast2SMS / Firebase Auth)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ourlittlejoys-clone
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Analytics & Monitoring
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Feature Flags
VITE_ENABLE_WALLET=true
VITE_ENABLE_WISHLIST=true
VITE_ENABLE_REVIEWS=true
VITE_ENABLE_ONLINE_PAYMENTS=true

# Environment
VITE_ENVIRONMENT=development
