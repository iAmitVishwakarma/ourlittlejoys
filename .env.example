# ==============================================================================
# OUR LITTLE JOYS - FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# API Base URL (Used when VITE_USE_MOCK=false)
# Set to your live or staging REST backend URL
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Request Timeout in milliseconds (default: 10000)
VITE_API_TIMEOUT=10000

# Mock Mode Toggle
# true  = Run standalone in-browser using local storage & mock seed data (default for UI preview)
# false = Route all service calls to real REST endpoints via apiClient
VITE_USE_MOCK=true

# Payment Gateway (Razorpay Public Key)
# NOTE: Only the public key_id is safe in client bundles.
# Never expose RAZORPAY_KEY_SECRET on the client.
VITE_RAZORPAY_KEY_ID=rzp_test_mock_littlejoys

# Analytics & Monitoring (Optional)
VITE_GOOGLE_ANALYTICS_ID=

# Environment
VITE_ENVIRONMENT=development
